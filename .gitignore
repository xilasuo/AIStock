# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# ---- testing ----
/coverage

# ---- build outputs (Next.js / Vite + Cloudflare Workers) ----
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/
/backups/
.vercel

# ---- vite / typescript caches ----
/.vite
*.tsbuildinfo
next-env.d.ts

# ---- logs (本地开发与服务运行产生的日志) ----
/logs/
*.log

# ---- env & secrets (切勿提交，含 API 密钥) ----
.env
.env.*
!.env.example
.dev.vars

# ---- OS junk ----
.DS_Store
Thumbs.db
*.pem

# ---- local auth / runtime secrets (会话 cookie 等，切勿提交) ----
.auth-cookie.txt
*.cookie.txt

# ---- personal IDE / agent data (不共享的个人开发数据) ----
.codebuddy/
.workbuddy/

# ---- local runtime data ----
# deploy.sh 中说明数据目录为 $PROJECT_DIR/data (D1 SQLite)，属本地运行产物
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# ---- temp / backup files ----
*.bak
*.bak.*
*.tmp

# ---- local scripts (含测试凭证的本地调试脚本) ----
/scripts/repro.mjs

# ---- deploy marker (deploy.sh 记录上次构建的源码 commit) ----
.last_build_commit

# ---- Python (trading_agent/) ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- trading_agent: runtime cache & generated reports ----
trading_agent/cache/
trading_agent/reports/
trading_agent/feedback.jsonl

# ---- trading_agent: 根目录遗留报告（防误提交，应以 reports/ 为准） ----
trading_agent/report_*.md
trading_agent/hub_report_*.md

# ---- trading_agent: 本地联调临时数据 ----
trading_agent/.tmp_cloud/
trading_agent/*tmp_filter.json
trading_agent/_tmp_filter*.json

# ---- trading_agent: 扫描与信号输出（本地运行产物） ----
trading_agent/prefetched.json
trading_agent/prefetched_*.json
trading_agent/scan_payload.json
trading_agent/signals_out.json
trading_agent/watchlist.json

# ---- trading_agent: 本地模块级忽略规则（含敏感/临时） ----
trading_agent/.gitignore

# ---- trading_agent: 云端凭据与连接快照（含真实 IP / token / sha256，切勿推送） ----
trading_agent/cloud_config_snapshot.json
trading_agent/cloud_strategy_receipt.json
trading_agent/strategy_config.yaml

# ---- trading_agent: 含真实凭据的本地联调探针脚本 + dev/ 本地联调工具目录（不入库） ----
trading_agent/dev/
trading_agent/probe_cloud_test.py
trading_agent/fetch_cloud_test.py
trading_agent/verify_cloud_read.py
trading_agent/reset_cloud_config.py

# ---- trading_agent: 联调预览 / 临时数据 / 运行缓存 ----
trading_agent/integration_preview.html
trading_agent/.tmp_cloud/
trading_agent/cloud_test_out/
trading_agent/cloud_test_out_fallback/
trading_agent/cloud_test_out_false/
trading_agent/cache/
trading_agent/reports/
trading_agent/feedback.jsonl
trading_agent/market_universe.json
trading_agent/market_universe_*.json
trading_agent/prefetched.json
trading_agent/prefetched_*.json
trading_agent/prefetched_verify.json
trading_agent/test_universe_conn.json
trading_agent/*.snapshot.json
trading_agent/*_snapshot.json
trading_agent/scan_summary.json
trading_agent/report_*.txt
dev/

# ---- Playwright (e2e 测试产物) ----
/test-results/
/playwright-report/

# K线面板调试产物（render_kline.py 测试输出，正式产物在 reports/）
/*.svg
